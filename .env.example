# LLM provider keys: set the key for every provider used in the model chains below
GEMINI_API_KEY=your-gemini-api-key
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Supabase (required for web UI)
SUPABASE_URL=https://xxx.supabase.co
# Optional: custom Supabase auth domain (e.g. https://auth.hrbreaker.co).
# When set, JWKS is fetched from SUPABASE_AUTH_URL/.well-known/jwks.json instead.
# SUPABASE_AUTH_URL=https://auth.hrbreaker.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret

# API CORS origins (comma-separated)
# API_CORS_ORIGINS=http://localhost:3000

# Models: comma-separated provider:model chain. First = primary, rest = fallbacks
# used on transient errors (429 / 5xx / connection / timeout).
# Providers: google-gla (GEMINI_API_KEY), anthropic (ANTHROPIC_API_KEY), openai (OPENAI_API_KEY)
# OPTIMIZATION_MODEL=google-gla:gemini-2.5-flash   # optimizer, reviewer, parser, filters, auditor
# COACH_MODEL=google-gla:gemini-2.5-pro            # career coach
# NAME_EXTRACTOR_MODEL=google-gla:gemini-2.5-flash-lite
# Example with fallback:
# OPTIMIZATION_MODEL=google-gla:gemini-2.5-flash,anthropic:claude-sonnet-5-5
# MODEL_PROVIDER_TIMEOUT=120   # per-provider request timeout (seconds)
# MODEL_CALL_TIMEOUT=300       # outer timeout around a whole call incl. fallbacks

# Logging
# LOG_LEVEL=WARNING          # hr-breaker logger
# LOG_LEVEL_GENERAL=WARNING  # global

# Mode (parallel checks)
# HR_BREAKER_FAST_MODE=true

# Optimization loop
# MAX_ITERATIONS=3   # hard cap; loop stops earlier when audit quality converges

# Scraper settings
# SCRAPER_HTTPX_TIMEOUT=15
# SCRAPER_WAYBACK_TIMEOUT=10
# SCRAPER_PLAYWRIGHT_TIMEOUT=30000
# SCRAPER_HTTPX_MAX_RETRIES=3
# SCRAPER_WAYBACK_MAX_AGE_DAYS=30
# SCRAPER_MIN_TEXT_LENGTH=200

# Filter thresholds
# FILTER_HALLUCINATION_THRESHOLD=0.9
# FILTER_KEYWORD_THRESHOLD=0.25
# FILTER_LLM_THRESHOLD=0.7
# FILTER_VECTOR_THRESHOLD=0.4
# FILTER_AI_GENERATED_THRESHOLD=0.4

# Resume length limits
# RESUME_MAX_CHARS=4500
# RESUME_MAX_WORDS=520
# RESUME_PAGE2_OVERFLOW_CHARS=1000

# Keyword matcher
# KEYWORD_TFIDF_MAX_FEATURES=200
# KEYWORD_TFIDF_CUTOFF=0.1
# KEYWORD_MAX_MISSING_DISPLAY=10

# Model settings
# SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Agent limits
# AGENT_NAME_EXTRACTOR_CHARS=2000

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_JOB_HUNTER=price_...
STRIPE_PRICE_OFFER_MODE=price_...

# Paywall
UNLIMITED_USERS=admin@example.com

# Feedback / Resend (required for /api/feedback to deliver emails)
RESEND_API_KEY=re_xxx
SUPPORT_EMAIL_TO=support@example.com
SUPPORT_EMAIL_FROM=noreply@example.com
